VITE_API_BASE_URL=https://api.themoviedb.org/
VITE_API_VERSION=3

VITE_API_KEY=
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p/
VITE_API_ACCESS_TOKEN=

# Force the anti-inspect guard on in `yarn dev` (it is always on in production).
# Leave unset / 0 for normal dev. Set to 1 to test right-click block, DevTools
# detection, console muting, etc. without doing a full production build.
VITE_ANTI_INSPECT=0

# Python sync: scripts/catalog_tmdb_lib.py (TMDB API key)
# TMDB_API_KEY=

# Cloudflare R2 poster sync: (populates poster cache for the app)
# Run docs/poster_cache_migration.sql first, then pip install -r scripts/requirements-sync.txt
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=moovie-posters
# R2_PUBLIC_BASE_URL=https://pub-e02804745b25477d92749907eb1264ce.r2.dev